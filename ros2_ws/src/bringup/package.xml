<?xml version="1.0"?>
<package format="3">
  <name>bringup</name>
  <version>1.0.0</version>
  <description>VIST Teleoperation System Bringup Package</description>

  <maintainer email="your_email@example.com">VIST Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch dependencies -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Hardware and driver dependencies -->
  <exec_depend>linkerta</exec_depend>
  <exec_depend>lbot_driver</exec_depend>
  <exec_depend>lbot_teleop</exec_depend>
  <exec_depend>linker_hand_ros2_sdk</exec_depend>
  <exec_depend>camera_manager</exec_depend>

  <!-- Algorithm dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>